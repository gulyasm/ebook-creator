# Kindle email address (find it in: Amazon account > Manage Your Content and Devices > Preferences > Personal Document Settings)
KINDLE_EMAIL=yourname@kindle.com

# Gmail address used as sender (must be added to Amazon's approved senders list above)
SMTP_USER=youremail@gmail.com

# Gmail App Password (Google Account > Security > 2-Step Verification > App Passwords)
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
